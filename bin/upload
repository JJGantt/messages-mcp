#!/usr/bin/env python3
"""Upload files to the Mac's messages server; print the path send_message takes.

send_message runs on the Mac and takes paths on the Mac, so a file that exists
only on this machine is sent across first, to the server registration.py finds.

Streams each file rather than reading it into memory, which matters on the Pi.

usage: ~/repos/messages-mcp/bin/upload <file>...   (one Mac path per line)
"""

import json
import pathlib
import sys
import urllib.error
import urllib.parse
import urllib.request

from registration import registration


def main(args):
    if not args:
        sys.exit(__doc__.strip().splitlines()[-1])
    paths = [pathlib.Path(a) for a in args]
    for path in paths:
        if not path.is_file():
            sys.exit(f"{path} is not a file")
    endpoint, auth = registration()
    url = urllib.parse.urljoin(endpoint, "upload")
    for path in paths:
        with path.open("rb") as body:
            request = urllib.request.Request(
                f"{url}?{urllib.parse.urlencode({'name': path.name})}",
                data=body, method="POST",
                headers={"Authorization": auth,
                         "Content-Type": "application/octet-stream",
                         "Content-Length": str(path.stat().st_size)})
            try:
                with urllib.request.urlopen(request, timeout=300) as reply:
                    print(json.load(reply)["path"])
            except urllib.error.HTTPError as err:
                sys.exit(f"{path}: HTTP {err.code} {err.read().decode(errors='replace')}")


if __name__ == "__main__":
    main(sys.argv[1:])
