<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jaredgantt.messages-http</string>
  <!-- Through bin/fda-launch, which holds the Full Disk Access grant; see the README. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jaredgantt/repos/messages-mcp/bin/fda-launch</string>
    <string>/Users/jaredgantt/repos/messages-mcp/.venv/bin/python</string>
    <string>/Users/jaredgantt/repos/messages-mcp/serve_http.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/jaredgantt/repos/messages-mcp</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/jaredgantt/Library/Logs/messages-http.log</string>
  <key>StandardErrorPath</key><string>/Users/jaredgantt/Library/Logs/messages-http.log</string>
</dict>
</plist>
